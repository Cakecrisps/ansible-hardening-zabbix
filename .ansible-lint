---
# Профиль "min" — базовые правила (синтаксис, явные баги).
# Когда разберёшься с текущими замечаниями, подними до "basic" или "moderate":
# https://ansible.readthedocs.io/projects/lint/profiles/
profile: min

exclude_paths:
  - .github/

# Раскомментируй и дополняй по мере разбора конкретных предупреждений,
# которые пока не хочешь чинить (лучше временно, чем навсегда):
# skip_list:
#   - yaml[line-length]
